# ===== 必填 =====
# 数据加密密钥（Fernet）。首次生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-to-a-fernet-key

# 授权页(/setup)访问令牌，用于防止他人篡改您的网盘绑定
ADMIN_TOKEN=change-me-to-a-random-string

# ===== 可选 =====
# 初始夸克 Cookie（也可在 /setup 页面粘贴导入；格式: "kps=xx; sign=yy; vcode=zz; __puus=tt; ..."）
QUARK_COOKIE=

# 数据库与监听
DB_PATH=data/quark_stremio.db
HOST=0.0.0.0
PORT=8000
# 匹配置信度阈值 0-1，低于该值不返回播放源
MATCH_THRESHOLD=0.6
# 播放模式：0=播放直链（默认，网页播放器同源接口，客户端带 Cookie 直连，服务器不经手流量）；1=代理流（服务器取流转发，消耗服务器流量）
PROXY_STREAM=0
# 对外可访问地址（代理流链接前缀；候选资源页引导链接也用它），如 http://1.2.3.4 或 https://addon.example.com
BASE_URL=

# ===== 元数据（TMDB） =====
# TMDB v3 API key：优先读环境变量，其次项目根目录的 TMDB_API_KEY 文件（一行纯文本）
TMDB_API_KEY=
# 双语名/季集缓存有效期（秒），默认 7 天（连载剧集到期自动刷新）
TMDB_META_TTL=604800

# ===== 外部资源检索（阶段 3） =====
# PanSou 聚合搜索实例地址（github.com/fish2018/pansou，MIT）。
# 推荐自部署（前后端集成版，见 deploy/pansou/docker-compose.yml）：
#   cd deploy/pansou && docker compose up -d   # 仅绑定 127.0.0.1:8888
# 不部署时可用公开实例（波动较大，结果少且常超时）
PANSOU_BASE_URL=http://127.0.0.1:8888
# 单个搜索来源超时（秒）与候选数量上限
SEARCH_TIMEOUT=25
SEARCH_LIMIT=30

# ===== 转存 Worker（阶段 4） =====
# 转存目标目录（网盘根目录下的文件夹名；留空则直接转存到根目录）
TRANSFER_DIR=GODDAMNCOOL
# Worker 扫描待处理任务的间隔（秒）
TRANSFER_SCAN_INTERVAL=10
# 转存任务轮询间隔（秒）
TRANSFER_POLL_INTERVAL=2
# 转存轮询超时（秒），超时任务置为 EXPIRED
TRANSFER_TASK_TIMEOUT=600
# 瞬时错误最大尝试次数，超过置为 FAILED
TRANSFER_MAX_ATTEMPTS=3
